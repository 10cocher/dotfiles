#!/bin/bash
set -e

{{- if .is_shared}}
if ! command -v emacs &> /dev/null; then
    {{- if eq .chezmoi.osRelease.id "ubuntu" }}
        echo "Ubuntu detected. Installing modern Emacs-nox via PPA..."
        sudo apt update
        sudo apt install -y software-properties-common
        sudo add-apt-repository -y ppa:ubuntuhandbook1/emacs
        sudo apt update
        sudo apt install -y emacs-nox
    {{- else }}
        echo "Debian detected. Installing standard Emacs-nox..."
        sudo apt update
        sudo apt install -y emacs-nox
    {{- end }}
fi
{{- else }}
if ! command -v emacs &> /dev/null; then
    echo "Installing graphical and compilation dependencies for Emacs..."
    sudo apt install -y autoconf make gcc texinfo libgtk-3-dev libxpm-dev \
         libjpeg-dev libgif-dev libtiff5-dev libgnutls28-dev libncurses-dev \
         libjansson-dev libgccjit-13-dev libacl1-dev libtree-sitter-dev

    echo "Cloning Emacs source code..."
    git clone --depth 1 --branch "{{ .emacs_version }}" https://github.com/emacs-mirror/emacs.git ~/.emacs-source
    cd ~/.emacs-source

    echo "Configuring the Emacs build environment..."
    ./autogen.sh
    ./configure --with-modules --with-x-toolkit=gtk3 --with-native-compilation --with-tree-sitter

    echo "Compiling Emacs..."
    make -j$(nproc)

    echo "Installing Emacs to the system..."
    sudo make install

    echo "Emacs compilation complete!"
else
    echo "Emacs is already installed."
fi
{{- end }}
