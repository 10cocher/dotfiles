#!/bin/bash
set -e

# ==========================================
# uv
# ==========================================

if ! command -v uv &> /dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="{{ .bin_dir }}" UV_NO_MODIFY_PATH=1 sh
else
    echo "uv is already installed."
fi

# ==========================================
# D2 architecture diagrams
# ==========================================

if ! command -v d2 &> /dev/null; then
    echo "Installing d2..."
    curl -fsSL https://d2lang.com/install.sh | BINDIR={{ .bin_dir }} sh -s --
else
    echo "D2 is already installed."
fi

# ==========================================
# Mermaid-chart CLI
# ==========================================

if ! command -v mmdc &> /dev/null; then
    echo "Installing mermaid-chart CLI..."
    npm install -g @mermaid-js/mermaid-cli
else
    echo "mermaid-chart is already installed."
fi
