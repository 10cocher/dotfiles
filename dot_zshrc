# ==========================================
# PATH & ENVIRONMENT VARIABLES
# ==========================================
export NVM_DIR="$HOME/.nvm"
export PYENV_ROOT="$HOME/.pyenv"

# Add Pyenv and Mermaid to PATH
export PATH="$PYENV_ROOT/bin:$PATH"
export PATH="$HOME/.nvm/versions/node/v16.17.0/bin/mmdc:$PATH"

# Bypass GNOME: force local bins into PATH
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# ==========================================
# INITIALIZATIONS & COMPLETIONS
# ==========================================
# Initialize Pyenv
eval "$(pyenv init --path)"
eval "$(pyenv init -)"

# Initialize Rust
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Initialize Node (NVM)
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Initialize Zsh Completions
autoload -U +X bashcompinit && bashcompinit
autoload -U +X compinit && compinit


# ==========================================
# KEYBINDINGS (Smart History Search)
# ==========================================
# Make zsh autocomplete with up arrow
autoload -Uz history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey "$terminfo[kcuu1]" history-beginning-search-backward-end
bindkey "$terminfo[kcud1]" history-beginning-search-forward-end


# ==========================================
# ALIASES
# ==========================================
alias ll='ls -Al --color=auto'
alias la='ls -A --color=auto'
alias grep='grep --color=auto'

# VPN Aliases
alias vpnstart='openvpn3 session-start --config ~/openvpn.ovpn'
alias vpnstop='openvpn3 session-manage --disconnect --config ~/openvpn.ovpn'


# ==========================================
# TOOLS & PROMPT
# ==========================================
# direnv
eval "$(direnv hook zsh)"

# Starship Prompt
eval "$(starship init zsh)"

# Mise
[ -x "$HOME/.local/bin/mise" ] && eval "$($HOME/.local/bin/mise activate zsh)"

# Alacritty Completions
[ -f /home/ecocher/alacritty/extra/completions/_alacritty ] && fpath+=( /home/ecocher/alacritty/extra/completions )
