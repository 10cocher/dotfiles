{
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }{{ if .fbx_plugins_url }},
    "fbx-plugins": {
      "source": {
        "source": "git",
        "url": {{ .fbx_plugins_url | quote }}
      }
    }{{ end }}
  },
  "enabledPlugins": {
    {{ if .fbx_plugins_url }}"quality-review-plugin@fbx-plugins": true,
    {{ end -}}
    "example-skills@anthropic-agent-skills": true
  }
}
